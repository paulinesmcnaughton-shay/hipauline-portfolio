{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/matrix", "destination": "/portfolio2", "permanent": true },
    { "source": "/matrix.html", "destination": "/portfolio2", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
